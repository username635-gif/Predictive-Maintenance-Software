# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=reliabilityos
POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION
POSTGRES_DB=reliabilityos
DATABASE_URL=postgresql://reliabilityos:CHANGE_IN_PRODUCTION@localhost:5432/reliabilityos

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=CHANGE_IN_PRODUCTION
INFLUX_ORG=reliabilityos
INFLUX_BUCKET=sensor_data
INFLUX_USER=admin
INFLUX_PASSWORD=CHANGE_IN_PRODUCTION

# ─── MQTT ────────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ─── AI Service ──────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Edge Gateway ────────────────────────────────────────────────────────────
GATEWAY_ID=EG-04
GATEWAY_DESCRIPTION=Mile 250 Remote Station
CLOUD_API_URL=http://localhost:8080
CLOUD_SYNC_INTERVAL_S=30
SENSOR_POLL_INTERVAL_S=5

# ─── Simulator ───────────────────────────────────────────────────────────────
PUBLISH_INTERVAL_S=2
# SIMULATOR_SCENARIO=leak_active
